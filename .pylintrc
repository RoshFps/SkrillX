[MAIN]
py-version = 3.9
# Tests import tooling.* from the repository root, as tooling/run_tests.py runs them.
init-hook = import sys; sys.path.insert(0, ".")
# Semgrep fixtures deliberately shadow third-party modules such as requests.
ignore-paths =
    ^[.]proof/semgrep-tests/fixtures/.*$,
    ^examples/python-demo/[.]proof/semgrep-tests/fixtures/.*$,
    ^security/semgrep/tests/fixtures/.*$,
    ^tooling/tests/fixtures/.*$

[MESSAGES CONTROL]
# Start with error and fatal checks that can be applied to the whole repository
# without turning historical style and refactoring debt into a release blocker.
disable = all
enable = E, F
